# Exact, enumerable CPU chemistry configuration.
include 'configs/rgfn_base.gin'
include 'configs/proxies/target/qed.gin'

MiniReactionDataFactory.reaction_path = 'data/chemistry.xlsx'
MiniReactionDataFactory.reaction_families = ['Amide synthesis']
MiniReactionDataFactory.fragment_groups = ['Acids', 'Amines']
MiniReactionDataFactory.fragments_per_group = 8
MiniReactionDataFactory.docking = False
data_factory/gin.singleton.constructor = @MiniReactionDataFactory
data_factory = @data_factory/gin.singleton()

ReactionEnv.max_num_reactions = 1
ReactionEnv.data_factory = %data_factory
env/gin.singleton.constructor = @ReactionEnv
train_env = @env/gin.singleton()
valid_env = %train_env

beta = 4

NumScaffoldsFound.proxy_value_threshold_list = [0.4, 0.5, 0.6, 0.7]
TanimotoSimilarityModes.proxy_term_threshold = 0.6
TanimotoSimilarityModes.similarity_threshold = 0.5
TanimotoSimilarityModes.max_modes = 500
