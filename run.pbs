#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -j oe
#PBS -N seh_medium
#PBS -q auto
#PBS -l select=1:ngpus=1
#PBS -l walltime=24:00:00

# Train one seh_paper_medium method toward TARGET_ITER (default 500).
# Resumes automatically from last_gfn.pt when the checkpoint exists.
#
# Required: pass METHOD at submit time.
#
# Phase 1 (four parallel jobs to iteration 500):
#   bash submit_phase1.sh
#
# After checking all four checkpoints, phase 2 (500 -> 2500 + sample):
#   bash submit_phase2.sh
#
# Single manual submit:
#   qsub -N mips_p500 -v METHOD=mips_grpo run.pbs
#   qsub -N rgfn_p500 -v METHOD=rgfn run.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:-/home/svu/ophv165/ips_phylogentics}"
mkdir -p logs

METHOD="${METHOD:?Set METHOD=rgfn|grpo|count_ips_grpo|mips_grpo via qsub -v}"
TARGET_ITER="${TARGET_ITER:-500}"
DO_SAMPLE="${DO_SAMPLE:-0}"
SEED="${SEED:-0}"
SUITE="${SUITE:-seh_paper_medium}"

PY="${PY:-/home/svu/ophv165/miniconda3/envs/py311/bin/python}"
CFG="${CFG:-molecule_synthesis/external/RGFN/configs/rgfn_seh_proxy.gin}"
OUTPUT_ROOT="${OUTPUT_ROOT:-molecule_synthesis/runs}"

# Fixed run names so later phases resume the same directories.
case "${METHOD}" in
  mips_grpo)
    RUN_NAME="${RUN_NAME:-seh_paper_medium/mips_grpo/seed_0/20260827_112154}"
    ;;
  rgfn)
    RUN_NAME="${RUN_NAME:-seh_paper_medium/rgfn/seed_0/batch}"
    ;;
  grpo)
    RUN_NAME="${RUN_NAME:-seh_paper_medium/grpo/seed_0/batch}"
    ;;
  count_ips_grpo)
    RUN_NAME="${RUN_NAME:-seh_paper_medium/count_ips_grpo/seed_0/batch}"
    ;;
  *)
    echo "Unknown METHOD=${METHOD}" >&2
    exit 2
    ;;
esac

RUN_DIR="${OUTPUT_ROOT}/${RUN_NAME}"
CKPT="${RUN_DIR}/train/checkpoints/last_gfn.pt"
LOG_TAG="${SUITE}_${METHOD}_seed${SEED}_to${TARGET_ITER}"

export DGLBACKEND=pytorch
export LD_LIBRARY_PATH="$(
"${PY}" - <<'PY'
import os
paths = []
for pkg in ("cuda_nvrtc", "cuda_runtime", "cublas", "cusparse", "cufft", "curand", "cusolver", "nccl"):
    try:
        mod = __import__(f"nvidia.{pkg}", fromlist=["__file__"])
        libdir = os.path.join(os.path.dirname(mod.__file__), "lib")
        if os.path.isdir(libdir):
            paths.append(libdir)
    except ImportError:
        pass
print(":".join(paths))
PY
):${LD_LIBRARY_PATH:-}"

echo "=== ${LOG_TAG} ==="
echo "method=${METHOD}"
echo "host=$(hostname)"
echo "target_iter=${TARGET_ITER}"
echo "run_dir=${RUN_DIR}"
echo "checkpoint=${CKPT}"
nvidia-smi || true

TRAIN_CMD=(
  "${PY}" -m molecule_synthesis.train
  --method "${METHOD}"
  --cfg "${CFG}"
  --output-root "${OUTPUT_ROOT}"
  --run-name "${RUN_NAME}"
  --seed "${SEED}"
  --iterations "${TARGET_ITER}"
  --forward-trajectories 100
  --batch-size 100
  --max-reactions 4
  --device cuda
  --clip-eps 0.2
  --reward-mode linear
  --wandb-mode offline
)

case "${METHOD}" in
  rgfn)
    TRAIN_CMD+=(--replay-trajectories 20 --learning-rate 0.001)
    ;;
  grpo)
    TRAIN_CMD+=(--replay-trajectories 0 --learning-rate 0.001)
    ;;
  count_ips_grpo)
    TRAIN_CMD+=(--replay-trajectories 0 --learning-rate 0.001 --count-probability-floor 1e-6)
    ;;
  mips_grpo)
    TRAIN_CMD+=(
      --replay-trajectories 0
      --learning-rate 0.0001
      --reverse-learning-rate 0.001
      --reverse-train-epochs 4
      --reverse-grad-clip-norm 1.0
      --advantage-normalization running
      --running-scale-decay 0.9
      --advantage-clip 10.0
      --log-ratio-clip 20.0
      --exploration-rate 0.0
    )
    ;;
esac

if [[ -f "${CKPT}" ]]; then
  echo "Resuming from ${CKPT}"
  TRAIN_CMD+=(--checkpoint-path "${CKPT}")
else
  echo "No checkpoint found; starting fresh in ${RUN_DIR}"
fi

/usr/bin/time -p "${TRAIN_CMD[@]}"

if [[ -f "${CKPT}" ]]; then
  "${PY}" molecule_synthesis/scripts/write_last_epoch.py "${CKPT}"
else
  echo "ERROR: checkpoint missing after training: ${CKPT}" >&2
  exit 1
fi

if [[ "${DO_SAMPLE}" == "1" ]]; then
  echo "Running final sampling (50k molecules) ..."
  /usr/bin/time -p "${PY}" -m molecule_synthesis.sample \
    --run-dir "${RUN_DIR}" \
    --n-samples 50000 \
    --batch-size 100 \
    --device cuda \
    --mode-threshold 7.0 \
    --similarity-threshold 0.5 \
    --max-modes 5000 \
    --top-k 500 \
    --scaffold-thresholds 7.0,8.0
  echo "SAMPLE_SUMMARY=${RUN_DIR}/samples/summary.json"
fi

echo "DONE ${LOG_TAG}"
echo "RUN_DIR=${RUN_DIR}"
