    },
    "count_ips": {
      "cfg": "src/configs/benchmark_dna_cfgs/discrete_branch_lengths/cfg_0.001binsize_50bins_temperature_anneal_0.4_10taxa_shift5000.yaml"
    },
    "learned_reverse": {
      "cfg": "src/configs/benchmark_dna_cfgs/discrete_branch_lengths/cfg_0.001binsize_50bins_temperature_anneal_0.4_10taxa_shift5000.yaml",
      "reward_target": "shifted_linear",
      "reverse_lr": 0.001,
      "reverse_train_epochs": 4,
      "reverse_hidden_size": 256,
      "reverse_num_layers": 3
    },
    "phylgfn": {
      "backend": "og_code",
      "cfg": "og_code/src/configs/benchmark_dna_cfgs/discrete_branch_lengths/cfg_ds1_full_g4096_replay_op3277_r819_rb4096_10taxa_shift5000.yaml"
