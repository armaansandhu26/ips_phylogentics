\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The count estimator succeeds only while outcomes repeat.} Left: exact \(\ell _1\) distance to target. Right: modes recovered. Small-grid bars show mean and one standard deviation over three seeds; the large-grid suite is one seed. GFlowNet TB was run only in the large-grid suite.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:hypergrid-summary}{{1}{4}{\textbf {The count estimator succeeds only while outcomes repeat.} Left: exact \(\ell _1\) distance to target. Right: modes recovered. Small-grid bars show mean and one standard deviation over three seeds; the large-grid suite is one seed. GFlowNet TB was run only in the large-grid suite}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Positive control: counting works when outcomes repeat.} Terminal distributions for \(H=8,G=256\) (seed 0). GRPO collapses, count IPS recovers all four modes, and MIPS-GRPO most closely matches the target.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:h8-distributions}{{2}{4}{\textbf {Positive control: counting works when outcomes repeat.} Terminal distributions for \(H=8,G=256\) (seed 0). GRPO collapses, count IPS recovers all four modes, and MIPS-GRPO most closely matches the target}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Stress test: counting fails without repeats.} Terminal distributions for \(H=64,G=32\) (seed 0). GRPO and count IPS-GRPO recover one mode; MIPS-GRPO and GFlowNet TB recover all four.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:h64-distributions}{{3}{4}{\textbf {Stress test: counting fails without repeats.} Terminal distributions for \(H=64,G=32\) (seed 0). GRPO and count IPS-GRPO recover one mode; MIPS-GRPO and GFlowNet TB recover all four}{figure.3}{}}
\citation{zhou2024phylogfn}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Hypergrid results in the informative-count and sparse-count regimes. Modes is out of four and \(\ell _1\) is the unnormalized distance to \(p(x)\propto R(x)\), so values are comparable within but not across grid sizes. Small-grid entries are mean \(\pm \) standard deviation over three seeds; large-grid entries are seed 0 only.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:hypergrid}{{2}{5}{Hypergrid results in the informative-count and sparse-count regimes. Modes is out of four and \(\ell _1\) is the unnormalized distance to \(p(x)\propto R(x)\), so values are comparable within but not across grid sizes. Small-grid entries are mean \(\pm \) standard deviation over three seeds; large-grid entries are seed 0 only}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {More samples do not fix the collapsed policies.} Left: GRPO and count IPS do not find the missing modes after 50,000 samples. Right: they still achieve high mean reward, so mean reward alone does not measure distribution matching.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:hypergrid-diagnostics}{{4}{5}{\textbf {More samples do not fix the collapsed policies.} Left: GRPO and count IPS do not find the missing modes after 50,000 samples. Right: they still achieve high mean reward, so mean reward alone does not measure distribution matching}{figure.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Application I: Bayesian phylogenetic inference}{5}{section.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Matched no-replay five-taxa phylogenetic evaluation, one million self-sampled trajectories per method. All 105 topologies are enumerable. Log--log \(r\) is the pathwise probability--reward diagnostic; support metrics are required because a high correlation can coexist with missing topologies. IPS-GRPO denotes the within-group count estimator.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:phylo-main}{{3}{6}{Matched no-replay five-taxa phylogenetic evaluation, one million self-sampled trajectories per method. All 105 topologies are enumerable. Log--log \(r\) is the pathwise probability--reward diagnostic; support metrics are required because a high correlation can coexist with missing topologies. IPS-GRPO denotes the within-group count estimator}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Matched four-method phylogenetic comparison at five taxa.} GRPO, count-based IPS-GRPO, MIPS-GRPO, and PhyloGFN are evaluated without replay using one million final-policy trajectories each. MIPS-GRPO is the only method to cover all 105 exact topologies and retains 95.1\% distinct terminal signatures. PhyloGFN has nearly the same correlation but covers 15 topologies.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:phylo-four-methods}{{5}{6}{\textbf {Matched four-method phylogenetic comparison at five taxa.} GRPO, count-based IPS-GRPO, MIPS-GRPO, and PhyloGFN are evaluated without replay using one million final-policy trajectories each. MIPS-GRPO is the only method to cover all 105 exact topologies and retains 95.1\% distinct terminal signatures. PhyloGFN has nearly the same correlation but covers 15 topologies}{figure.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Application II: full-space molecular synthesis}{6}{section.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Full-space sEH proxy task after 2,500 policy updates. Values are mean \(\pm \) sample standard deviation across three seeds, with 50,000 independent final-policy samples per seed. Unique is the percentage of valid samples that are distinct. A mode has proxy above 7 and maximum Tanimoto similarity at most 0.5 under greedy leader selection.}}{7}{table.4}\protected@file@percent }
\newlabel{tab:molecule-main}{{4}{7}{Full-space sEH proxy task after 2,500 policy updates. Values are mean \(\pm \) sample standard deviation across three seeds, with 50,000 independent final-policy samples per seed. Unique is the percentage of valid samples that are distinct. A mode has proxy above 7 and maximum Tanimoto similarity at most 0.5 under greedy leader selection}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Full-space sEH final-policy comparison.} Each method was trained for 2,500 updates and evaluated with 50,000 independent samples for each of three seeds. Bars show the arithmetic mean across seeds, whiskers show \(\pm 1\) sample standard deviation, and circles show individual seeds. Modes have sEH proxy above 7 and maximum Tanimoto similarity at most 0.5 under greedy leader selection. Lower uniqueness whiskers are clipped to the display floor of the logarithmic panel.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:molecule-final}{{6}{7}{\textbf {Full-space sEH final-policy comparison.} Each method was trained for 2,500 updates and evaluated with 50,000 independent samples for each of three seeds. Bars show the arithmetic mean across seeds, whiskers show \(\pm 1\) sample standard deviation, and circles show individual seeds. Modes have sEH proxy above 7 and maximum Tanimoto similarity at most 0.5 under greedy leader selection. Lower uniqueness whiskers are clipped to the display floor of the logarithmic panel}{figure.6}{}}
